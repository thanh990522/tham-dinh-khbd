# Bắt buộc để soạn/nâng cấp/chấm bằng AI (lấy tại console.anthropic.com)
ANTHROPIC_API_KEY=
# Khuyến nghị khi đưa lên Internet: mã truy cập chung của trường (mỗi lượt soạn tốn phí API)
ACCESS_CODE=
# Tuỳ chọn
PORT=3000
# CLAUDE_MODEL=claude-opus-5-5
# MAX_RUNNING_JOBS=2
# Tắt cơ chế fallback phía máy chủ khi bị từ chối (mặc định bật)
# AI_FALLBACKS=off
# Dùng file cấu hình khác cho từng tổ/cơ sở
# SCHOOL_CONFIG=config/school.json
